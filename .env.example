# Copy this file to .env and fill in real values. NEVER commit .env.

# --- AI Studio (Gemini + Imagen) ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_ai_studio_api_key_here

# --- Google Cloud (Cloud TTS + Vertex AI for Veo) ---
# Get from: https://console.cloud.google.com/  (your project ID, not the project number)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1

# Optional overrides — leave blank to use defaults from src/config.py
GEMINI_MODEL=
IMAGEN_MODEL=
VEO_MODEL=
TTS_VOICE=

# --- Optional Postgres backend (V2 — run history + pgvector RAG) ---
# Set ENABLE_POSTGRES=true and DATABASE_URL to enable. Schema lives at src/db_schema.sql.
# Local dev with Docker:
#   docker run -d --name aivideo-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=aivideo \
#     pgvector/pgvector:pg16
ENABLE_POSTGRES=false
DATABASE_URL=
EMBEDDING_MODEL=text-embedding-005

# --- Optional MCP image server (V2 — call any image-gen tool over MCP) ---
# Two ready-to-use configurations below. Pick one or roll your own.

# CONFIG A (default) — bundled sample server using Imagen 4 Ultra (Google stack).
# Stays inside the original constraint. Higher-fidelity than the default Imagen 4.
ENABLE_MCP_IMAGE=false
MCP_IMAGE_SERVER_COMMAND=python
MCP_IMAGE_SERVER_ARGS=-m mcp_servers.imagen_server
MCP_IMAGE_TOOL_NAME=generate_image

# CONFIG B — evalstate/mcp-hfspace wrapping HuggingFace image-gen Spaces.
# Introduces non-Google models (FLUX, SDXL, etc.). Uncomment to use.
# Each --space flag adds one Space as a tool. Run discover_mcp_tools() after
# setup to find the exact tool name for each Space (varies per Gradio interface).
# Prereqs: Node.js installed; HF API token from https://huggingface.co/settings/tokens
#
# ENABLE_MCP_IMAGE=true
# MCP_IMAGE_SERVER_COMMAND=npx
# MCP_IMAGE_SERVER_ARGS=-y @llmindset/mcp-hfspace --space black-forest-labs/FLUX.1-schnell
# MCP_IMAGE_TOOL_NAME=black-forest-labs-FLUX-1-schnell
# HF_TOKEN=hf_your_token_here
